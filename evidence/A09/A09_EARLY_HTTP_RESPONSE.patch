+def request_with_early_response(connection, method, path, body, headers):
+    """Read an actual early HTTP refusal while sending the proposed body.
+
+    Oversize servers can close before sendall finishes. A sender OSError never
+    substitutes for an HTTP response: the caller must still observe status 413.
+    Keep the exact socket so HTTPConnection cannot reopen during this transfer.
+    """
+    connection.request(method, path, headers={**headers, 'Content-Length': str(len(body))})
+    wire = connection.sock
+    transfer = {'sent_bytes': 0, 'sender_error': None}
+    def send_body():
+        try:
+            for offset in range(0, len(body), 65536):
+                chunk = body[offset:offset + 65536]
+                wire.sendall(chunk)
+                transfer['sent_bytes'] += len(chunk)
+        except OSError as error:
+            transfer['sender_error'] = type(error).__name__
+    sender = threading.Thread(target=send_body, daemon=True)
+    sender.start()
+    try:
+        response = connection.getresponse()
+        data, received = response.read(), response.getheaders()
+        return response.status, data, received, transfer
+    finally:
+        connection.close()
+        wire.close()
+        sender.join(timeout=9)
+        if sender.is_alive():
+            raise RuntimeError('HTTP body sender did not terminate')
 
 
