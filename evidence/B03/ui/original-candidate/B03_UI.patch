  if(view==='stock')content=<><Card><h3>Залишки й партії</h3><p className="op-muted">Пошук за кодом або сканування етикетки у поле пошуку. Клавіатурний сканер працює як введення тексту.</p>{buttons([['Початковий залишок','opening'],['Переміщення','transfer'],['Резервування','reserve'],['Інвентаризація','adjust']])}<ERPTable onRow={r=>setSelection({kind:'lots',id:r.id})} rows={filter(data.lots)} columns={[["Партія",r=><><strong>{r.code}</strong><p>{itemLabel(r.item_id)}</p></>],["Місце",r=>location(r.location_id)?.name],["Фізично",r=>erpNum(r.quantity)+' '+item(r.item_id)?.unit],["Резерв",r=>erpNum(r.reserved)],["Доступно",r=><strong>{erpNum(r.available)}</strong>],["Якість",r=><>{status(r.quality)}{r.missing_documents.length>0&&<p className="erp-error">Бракує: {r.missing_documents.join(', ')}</p>}</>],["Дії",r=>buttons([['Перемістити','transfer',{lot_id:r.id}],['Документ','attach',{lot_id:r.id,kind:'certificate'}],['Перевірити','quality',{lot_id:r.id}]])]]}/></Card><Card><h3>Резерви</h3><ERPTable rows={data.reservations.filter(r=>Number(r.quantity)>0)} columns={[["Партія",r=>lot(r.lot_id)?.code],["Призначення",r=>r.line_id?order(data.lines.find(x=>x.id===r.line_id)?.order_id)?.code:job(r.production_id)?.code],["Кількість",r=>erpNum(r.quantity)],["Дія",r=>buttons([['Звільнити','release',{reservation_id:r.id,quantity:r.quantity}]])]]}/></Card><Card><h3>Поповнення мінімального запасу</h3><p className="op-muted">Придатний вільний залишок плюс усі очікувані поставки. Строки конкретних замовлень перевіряйте в огляді виконання.</p><ERPTable onRow={r=>setSelection({kind:'items',id:r.item_id})} rows={data.replenishment} columns={[["Матеріал",'code'],["Мінімум",r=>erpNum(r.minimum)+' '+r.unit],["Вільно",r=>erpNum(r.available)],["Очікується",r=>erpNum(r.incoming)],["Поповнити",r=>erpNum(r.suggested)]]}/></Card><Card><h3>Журнал складських рухів</h3><ERPTable onRow={r=>setSelection({kind:'lots',id:r.lot_id})} rows={data.movements} columns={[["Дата",r=>erpDate(r.created_at)],["Партія",r=>lot(r.lot_id)?.code],["Рух",r=>status(r.kind)],["Кількість",r=>erpNum(r.quantity)],["Документ",'reference'],["Підстава",'reason']]}/></Card></>;
  if(view==='production')content=<Card><h3>Виробництво та підрядники</h3>{buttons([['Нова робота','job']])}{filter(data.jobs).map(j=><div className="erp-plan" key={j.id}><div className="erp-row"><div><h4><BoSLink onClick={()=>setSelection({kind:'jobs',id:j.id})}>{j.code} · {itemLabel(j.item_id)}</BoSLink></h4><p>{location(j.location_id)?.name} · {person(j.owner_id)} · до {erpDate(j.due_date)}</p><p>План {erpNum(j.quantity)}, випущено {erpNum(j.produced)} · версія {j.revision} · {status(j.status)}</p>{j.needs_review&&<p className="erp-error">Зупинено до рішення щодо зміни версії</p>}</div></div>{buttons([['Передати матеріали','transfer',{production_id:j.id,location_id:j.location_id}],['Резерв матеріалу','reserve',{production_id:j.id}],...(!j.needs_review&&j.status==='planned'?[['Почати','start',{production_id:j.id}]]:[]),...(!j.needs_review&&j.status==='running'?[['Результат операції','operator',{production_id:j.id}],['Випуск','finish',{production_id:j.id}]]:[]),['Перенести строк','postpone_job',{production_id:j.id}],...(j.needs_review?[['Дозволити стару версію','resolve_job',{production_id:j.id}]]:[])])}<div className="erp-steps">{j.routing.map((s,i)=>{const done=data.operator_entries.filter(e=>e.production_id===j.id&&e.operation===s.name).at(-1)?.result==='done';return <div key={s.name}><strong>{i+1}. {s.name}</strong><p>{s.instruction}</p><p className="op-muted">{done?'Завершено':'Очікує результату'} · {s.days} дн.</p></div>;})}</div><details><summary>Матеріали, результати й витрати</summary>{j.bom.map(b=><p key={b.item_id}>{itemLabel(b.item_id)}: {b.quantity} на одиницю</p>)}{bosCan('finance')&&<p>План: {j.planned_cost} {j.currency}; факт: {j.actual_cost} {j.currency}</p>}{data.operator_entries.filter(e=>e.production_id===j.id).map(e=><p key={e.id}>{e.operation} · {ERP_LABELS[e.result]} · {e.minutes} хв · дефектів {e.defects} · {e.note}</p>)}</details></div>)}</Card>;
- if(view==='purchase')content=<><Card><h3>Постачання матеріалів</h3>{buttons([['Нове замовлення','purchase']])}<ERPTable onRow={r=>setSelection({kind:'purchases',id:r.id})} rows={filter(data.purchases)} columns={[["Номер / постачальник",r=><><strong>{r.code}</strong><p>{partner(r.supplier_id)}</p></>],["Номенклатура",r=>itemLabel(r.item_id)],["Замовлено / отримано",r=><>{erpNum(r.quantity)+' / '+erpNum(r.received)}{r.approval_snapshot?.source==='imported_open_balance'&&<p className="op-muted">Перенесено / прийнято після зрізу</p>}</>],["Поставка",r=><>{erpDate(r.due_date)}{r.due_date!==r.original_due&&<p className="erp-error">Початково {erpDate(r.original_due)}</p>}</>],...(bosRole()!=='observer'?[["Вартість",r=>erpNum(Number(r.quantity)*Number(r.price)+Number(r.extras))+' '+r.currency]]:[]),["Робота",r=>job(r.production_id)?.code||'—'],["Дії",r=>buttons([['Приймання','receive',{purchase_id:r.id,quantity:purchaseRemaining(r.quantity,r.received)}],['Змінити строк','postpone',{purchase_id:r.id}]])]]}/></Card><Card><h3>Оцінка постачальників за історією</h3><ERPTable onRow={r=>setSelection({kind:'partners',id:r.supplier_id})} rows={data.supplier_scores} columns={[["Постачальник",'name'],["Замовлень",'orders'],["Приймань",'receipts'],["Вчасно",r=>r.on_time_pct===null?'Ще немає даних':r.on_time_pct+'%'],["Невідповідності",'nonconformities'],["Перенесені строки",'rescheduled']]}/><p className="op-muted">Вчасність рахується за подіями приймання відносно початкової дати. Невідповідності — за записами перевірок.</p></Card></>;
