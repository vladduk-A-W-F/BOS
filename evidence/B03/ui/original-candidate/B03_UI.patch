  if(view==='quality')content=<><Card><h3>Якість і комплектність</h3>{buttons([['Перевірка партії','quality'],['Додати документ','attach']])}<ERPTable onRow={r=>setSelection({kind:'lots',id:r.id})} rows={filter(data.lots).filter(x=>x.quality!=='approved'||x.missing_documents.length)} columns={[["Партія",'code'],["Номенклатура",r=>itemLabel(r.item_id)],["Стан",r=>status(r.quality)],["Бракує документів",r=>r.missing_documents.join(', ')||'Перевірте результати контролю'],["Дії",r=>buttons([['Рішення','quality',{lot_id:r.id}]])]]}/></Card><Card><h3>Зміни креслень і специфікацій</h3>{buttons([['Нова зміна','change']])}<ERPTable onRow={r=>setSelection({kind:'changes',id:r.id})} rows={filter(data.changes)} columns={[["Зміна",'code'],["Виріб",r=>itemLabel(r.item_id)],["Версія",'target_revision'],["Причина",'reason'],["Стан",r=>status(r.status)],["Дії",r=><div className="erp-actions"><Button onClick={async()=>{try{setImpact(await erpFetch('changes/'+r.id+'/impact/'));}catch(e){setError(e.message);}}}>Вплив</Button><Button onClick={()=>setDoc(r.document_id)}>Документ</Button>{r.status==='draft'&&bosCanAction('apply_change')&&<Button onClick={()=>begin('apply_change',{change_id:r.id})}>Погодити</Button>}</div>]]}/>{impact&&<div className="erp-confirm"><strong>{impact.change} · вплив зміни</strong><p>Роботи: {impact.jobs.map(x=>x.code+' ('+x.revision+')').join(', ')||'немає'}</p><p>Замовлення: {impact.orders.map(x=>x.code).join(', ')||'немає'}</p></div>}</Card><Card><h3>Історія перевірок</h3><ERPTable rows={data.inspections} columns={[["Партія",r=>lot(r.lot_id)?.code],["Результат",r=>status(r.result)],["Перевірив",r=>person(r.inspector_id)],["Підстава",'note']]}/></Card></>;
- if(view==='costs'&&bosCan('finance'))content=<><Card><h3>Собівартість і маржа відвантажень</h3><ERPTable onRow={r=>setSelection({kind:'orders',id:r.order_id})} rows={data.costs} columns={[["Замовлення",'code'],["Сума замовлення",r=>erpNum(r.order_value)+' '+r.currency],["Відвантажено на",r=>erpNum(r.shipped_value)],["Собівартість відвантажень",r=>erpNum(r.shipped_cost)],["Різниця",r=>erpNum(r.gross_margin)]]}/><p className="op-muted">Управлінський розрахунок без податків і загальних витрат. Повернення потребують окремого фінансового коригування.</p></Card><Card><h3>Рахунки й оплати</h3>{buttons([['Рахунок','invoice'],['Зареєструвати оплату','payment']])}<ERPTable onRow={r=>setSelection({kind:'invoices',id:r.invoice_id})} rows={data.invoices} columns={[["Рахунок",'code'],["Замовлення",r=>order(r.order_id)?.code],["Сума",r=>erpNum(r.amount)+' '+r.currency],["Сплачено",r=>erpNum(r.paid)],["Відкрито",r=>erpNum(r.open)],["Термін",r=>erpDate(r.due_date)],["Дія",r=>buttons([['Оплата','payment',{invoice_id:r.invoice_id}]])]]}/></Card><Card><h3>Журнал погоджених ERP-операцій</h3><ERPTable onRow={r=>setSelection({kind:'events',id:r.id})} rows={data.events} columns={[["Дата",r=>erpDate(r.created_at)],["Дія",r=>(r.action==='erp_import_batch'?'Початковий імпорт':ERP_ACTIONS[r.action.replace('erp_','')]?.[0]||r.action)],["Роль",r=>r.role==='ceo'?'Керівник':'Менеджер'],["Результат",r=>r.result?.code||r.result?.reference||r.result?.note||'Запис журналу №'+r.id]]}/></Card></>;
- return <div className="erp-workspace"><div className="erp-row"><div><h2>ERP · {({overview:'Огляд виконання',catalog:'Номенклатура',sales:'Продажі',stock:'Склад',production:'Виробництво',purchase:'Постачання',quality:'Якість і зміни',costs:'Фінансовий результат'})[view]}</h2><p className="op-muted">Єдині замовлення, матеріали та відповідальні</p></div><div className="erp-actions"><Input aria-label="Пошук ERP" placeholder="Код, назва, штрихкод…" value={search} onChange={e=>setSearch(e.target.value)}/><Button onClick={refresh}>Оновити</Button>{bosRole()==='ceo'&&<Button onClick={()=>setInitialImport(true)}>Початковий імпорт</Button>}{bosCan('export_workspace')&&<a style={{color:T.primary}} href="/api/erp/export/">Контекст для AI</a>}</div></div>{error&&<p className="erp-error" role="alert">{error}</p>}{notice&&<p className="erp-notice" role="status">{notice}</p>}{lastReceipt&&<Card><h3>Фактичний вплив останньої дії</h3><ImpactTable changes={lastReceipt.impact}/><Button onClick={()=>setLastReceipt(null)}>Приховати</Button></Card>}{content}{selection&&<BoSInspector selection={selection} data={data} onClose={()=>setSelection(null)} onSelect={setSelection} onAction={begin} onNavigate={onNavigate}/>} {action&&<ERPActionDialog action={action.type} preset={action.preset} data={data} onClose={()=>setAction(null)} onDone={r=>{setLastReceipt(r);setNotice('Операцію збережено. Запис журналу №'+r.erp_event_id+(r.note?' · '+r.note:''));refresh();refetchTasks?.();}}/>}{initialImport&&<InitialImportDialog data={data} onClose={()=>setInitialImport(false)} onDone={r=>{setNotice('Імпорт збережено. Журнал №'+r.erp_event_id);refresh();}} onOpenRecord={async (mapping,isCurrent)=>{const fresh=await erpFetch('snapshot/');if(!isCurrent())return;setData(fresh);const kind={counterparty:'partners',item:'items',location:'locations',opening_lot:'lots',sales_order:'orders',sales_line:'orders',purchase_open_balance:'purchases'}[mapping.entity];const id=mapping.entity==='sales_line'?fresh.lines.find